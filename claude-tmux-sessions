#!/bin/bash
# Save the running Claude Code sessions, and relaunch them after a VM
# restart or crash, one tmux window each, in their original order. Only
# sessions given a name (with /rename or --name) count; the others are
# ignored.
#
#   claude-tmux-sessions save          record this container's live named
#                                      sessions and their window order
#   claude-tmux-sessions resume [-n|--dry-run]
#                                      resume each recorded session in a new
#                                      window (-n: print what would run)
#   claude-tmux-sessions rename        name the existing windows after the
#                                      sessions running in them
#   claude-tmux-sessions sync          save, then rename (for a Stop hook)
#   claude-tmux-sessions list          show the saved snapshot
#   claude-tmux-sessions backup <dir>  save, then write the snapshots and
#                                      transcripts, encrypted with a
#                                      passphrase, to a file in <dir>
#   claude-tmux-sessions restore <file>
#                                      put a backup's transcripts and
#                                      snapshots in place, and list the
#                                      directories missing here
#   claude-tmux-sessions move [-n|--dry-run] <old dir> <new dir>
#                                      move the transcripts, memory and
#                                      snapshot entries of the stopped
#                                      sessions of a directory that moved
#
# Each distrobox container keeps its own snapshot (by $CONTAINER_ID, or
# "host" outside one), because its sessions need its own claude and tmux
# to restart. Run resume and restore inside the container. Home and the PID namespace
# are shared, so every container sees all sessions; a session belongs to
# the container named in its process's environment.
#
# Claude Code keeps ~/.claude/sessions/<pid>.json (name, cwd, sessionId)
# only while a session runs, so `save` copies what is needed into a
# snapshot that survives a crash, along with the tmux server (socket from
# the session's $TMUX, binary from the server process) and window
# position, so a server run by tmux or opentmux is reached with the same
# program. A save that finds no live
# sessions leaves the old snapshot alone, so saving right after a reboot
# does not wipe it. `resume` skips sessions that are already running
# again, and appends the windows in their saved order. It refuses to
# start any session while a saved session's directory is missing, so
# the checkouts can be cloned first.
#
# `backup` moves sessions to another machine, e.g. through a synced
# folder: it writes claude-backup-<host>-<time>.tar.zst.gpg with every
# container's snapshot and ~/.claude/projects (transcripts and memory),
# encrypted with `gpg --symmetric` (gpg asks for the passphrase). The
# transcripts of sessions under ~/src/embargoed are left out. `restore`
# decrypts one, copies in each file that is missing here or older (a
# newer local transcript is kept), and lists the session and
# transcript directories that don't exist on this machine; it exits 3
# if any session directory is missing. Paths are kept as they were, so
# the machines need the same home directory and container names.
#
# `move` is for a checkout or folder that moved (another owner, a
# synced folder reached through a symlink). Claude Code files a
# session's transcripts and memory under ~/.claude/projects/ by the
# directory it started in (symlinks resolved, each non-alphanumeric
# character as "-"), and `claude --resume` only finds them under the
# current directory's name. Move the directory first, then run `move`
# with the old path and the new one: it moves the project folders of
# the directory and of directories under it, merging into folders that
# already exist (MEMORY.md lines are appended; any other file in both
# stops it before anything changes), rewrites the "cwd" fields in
# their transcripts that name the old path (keeping the files' times,
# for restore), and updates every container's snapshot. It refuses
# while a session of either directory is running. Left alone, and
# listed: memory files that mention the old path, and Claude Code's
# per-directory settings in ~/.claude.json (trust, allowed tools),
# which other sessions rewrite while they run, so Claude Code asks
# for trust again on the first start in the new directory.
#
# Environment: CLAUDE_TMUX (the tmux program; overrides the recorded one,
# else opentmux if installed, else tmux), CLAUDE_TMUX_SOCKET (server
# name for sessions saved outside tmux, default fedora, i.e.
# `opentmux -L fedora`).
set -euo pipefail
umask 077

container=${CONTAINER_ID:-host}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux-sessions
state=$state_dir/$container.tsv
# extra gpg options for backup and restore (used by tests)
read -ra gpg_opts <<<"${CLAUDE_BACKUP_GPG_OPTS:-}"

# backup and restore store paths relative to the home directory
need_state_in_home() {
    case $state_dir in "$HOME"/*) ;; *)
        echo "$state_dir is outside $HOME; not supported" >&2; exit 1 ;;
    esac
}
fallback_bin=$(command -v opentmux || echo tmux)
default_socket=${CLAUDE_TMUX_SOCKET:-fedora}

# the tmux program to use for a server recorded as run by $1
pick_bin() {
    if [ -n "${CLAUDE_TMUX:-}" ]; then
        echo "$CLAUDE_TMUX"
    elif [ -n "$1" ] && [ -x "$1" ]; then
        echo "$1"
    else
        echo "$fallback_bin"
    fi
}

# tmux program $1 on the server at socket path $2 ("" for the default
# server)
tmux_at() {
    local bin sock=$2
    bin=$(pick_bin "$1")
    shift 2
    if [ -n "$sock" ]; then
        "$bin" -S "$sock" "$@"
    else
        "$bin" -L "$default_socket" "$@"
    fi
}

# the server option for socket path $1, for messages
server_opt() {
    if [ -n "$1" ]; then echo "-S $1"; else echo "-L $default_socket"; fi
}

# name<TAB>cwd<TAB>sessionId<TAB>pid<TAB>socket<TAB>tmux program for each
# live, named, interactive session of this container
live_sessions() {
    local f pid env tmux_env sock bin
    for f in "$HOME"/.claude/sessions/*.json; do
        [ -e "$f" ] || continue
        pid=$(jq -r .pid "$f")
        # the pid must still be a claude process, not a reused one
        [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = claude ] || continue
        # keep only the two variables needed, so the rest of the
        # environment (secrets included) never lands in a variable or
        # in `bash -x` output
        env=$(tr '\0' '\n' 2>/dev/null < "/proc/$pid/environ" |
            grep -E '^(CONTAINER_ID|TMUX)='
            exit "${PIPESTATUS[0]}") || continue
        [ "$(sed -n 's/^CONTAINER_ID=//p' <<<"$env")" = "${CONTAINER_ID:-}" ] ||
            continue
        # $TMUX is "socket,server pid,session"
        tmux_env=$(sed -n 's/^TMUX=//p' <<<"$env")
        sock=${tmux_env%%,*}
        bin=""
        if [ -n "$tmux_env" ]; then
            tmux_env=${tmux_env#*,}
            # an upgraded binary reads as "<path> (deleted)"
            bin=$(readlink "/proc/${tmux_env%%,*}/exe" 2>/dev/null || true)
            bin=${bin% (deleted)}
        fi
        jq -r --arg sock "$sock" --arg bin "$bin" \
            'select(.kind == "interactive" and .nameSource == "user")
             | [.name, .cwd, .sessionId, .pid, $sock, $bin] | @tsv' "$f"
    done
}

# live_sessions plus the tmux session, window index and window id each
# one runs in (empty when it is not in a tmux window), in window order
located_sessions() {
    local name cwd id pid sock bin p loc
    declare -A panes
    local servers
    servers=$(live_sessions | cut -f5,6 | sort -u)
    while IFS=$'\t' read -r sock bin; do
        [ -n "$sock" ] || continue
        while IFS=$'\t' read -r p loc; do
            panes[$sock/$p]=$loc
        done < <(tmux_at "$bin" "$sock" list-panes -a \
            -F $'#{pane_pid}\t#{session_name}\t#{window_index}\t#{window_id}' \
            2>/dev/null || true)
    done <<<"$servers"
    live_sessions | while IFS=$'\t' read -r name cwd id pid sock bin; do
        # walk up from the claude process to the pane's shell
        loc=$'\t\t'
        p=$pid
        while [ -n "$sock" ] && [ "$p" -gt 1 ]; do
            if [ -n "${panes[$sock/$p]:-}" ]; then
                loc=${panes[$sock/$p]}
                break
            fi
            p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 1)
        done
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$name" "$cwd" "$id" "$pid" "$sock" "$bin" "$loc"
    done | sort -t $'\t' -k5,5 -k7,7 -k8,8n -k1,1f
}

save() {
    local tmp
    # name, cwd, sessionId, socket, tmux program; in window order
    tmp=$(located_sessions | cut -f1-3,5,6)
    if [ -z "$tmp" ]; then
        echo "no live sessions in $container; keeping $state" >&2
        return 0
    fi
    mkdir -p "$(dirname "$state")"
    printf '%s\n' "$tmp" > "$state.new"
    mv "$state.new" "$state"
}

resume() {
    local dry=0 running missing name cwd id sock bin cmd
    declare -A attach=()
    case "${1:-}" in -n|--dry-run) dry=1 ;; esac
    [ -s "$state" ] || { echo "no snapshot at $state" >&2; exit 1; }
    running=$(live_sessions | cut -f3)
    # check every directory before starting anything
    missing=$(while IFS=$'\t' read -r name cwd id _; do
        grep -qxF "$id" <<<"$running" || [ -d "$cwd" ] ||
            printf '  %s: %s\n' "$name" "$cwd"
    done < "$state")
    if [ -n "$missing" ]; then
        printf 'missing directories, nothing started:\n%s\n' "$missing" >&2
        echo "clone or create them, then run resume again" >&2
        exit 1
    fi
    while IFS=$'\t' read -r name cwd id sock bin; do
        if grep -qxF "$id" <<<"$running"; then
            echo "skip $name: already running"
            continue
        fi
        if [ $dry = 1 ]; then
            echo "would open window '$name' in $cwd with" \
                "$(pick_bin "$bin") $(server_opt "$sock"):" \
                "claude --resume $id"
            continue
        fi
        # then a shell, so the window stays open if claude exits
        cmd="claude --resume $id; exec ${SHELL:-/bin/bash}"
        if tmux_at "$bin" "$sock" has-session 2>/dev/null; then
            # append after the last window, keeping the saved order
            tmux_at "$bin" "$sock" new-window -d -a -t '{end}' -n "$name" \
                -c "$cwd" "$cmd"
        else
            [ -z "$sock" ] || mkdir -p -m 700 "$(dirname "$sock")"
            tmux_at "$bin" "$sock" new-session -d -n "$name" -c "$cwd" "$cmd"
        fi
        echo "opened window '$name'"
        attach["$(pick_bin "$bin") $(server_opt "$sock") attach"]=1
    done < "$state"
    for cmd in "${!attach[@]}"; do
        echo "attach with: $cmd"
    done
}

# the directory a project's transcripts were recorded in, from the
# first "cwd" field in them
project_cwd() {
    local f
    for f in "$1"/*.jsonl; do
        [ -e "$f" ] || continue
        grep -m1 -o '"cwd":"[^"]*"' "$f" | sed 's/^"cwd":"//; s/"$//' &&
            return 0
    done
    return 1
}

# kind<TAB>label<TAB>directory for what a backup needs on the other
# machine: each saved session's directory, then each project's
backup_manifest() {
    local f d cwd
    for f in "$state_dir"/*.tsv; do
        [ -e "$f" ] || continue
        cut -f1,2 "$f" | sed "s|^|session\t$(basename "$f" .tsv)/|"
    done
    for d in "$HOME"/.claude/projects/*/; do
        d=${d%/}
        case $d in *-src-embargoed*) continue ;; esac
        cwd=$(project_cwd "$d") || continue
        printf 'transcripts\t%s\t%s\n' "$(basename "$d")" "$cwd"
    done
}

backup() {
    local dest=${1:-} out
    [ -n "$dest" ] || { echo "usage: $0 backup <dir>" >&2; exit 2; }
    [ -d "$dest" ] || { echo "$dest is not a directory" >&2; exit 1; }
    need_state_in_home
    save
    out=$dest/claude-backup-$(hostname -s)-$(date +%Y%m%dT%H%M).tar.zst.gpg
    # global, and on EXIT: with set -e a failure exits without
    # returning, and the trap runs after the function's locals are gone
    workdir=$(mktemp -d)
    trap 'rm -rf "$workdir"' EXIT
    mkdir "$workdir/claude-backup"
    backup_manifest > "$workdir/claude-backup/manifest.tsv"
    # a partial file must not sync, so write next to it and rename
    tar -cf - -C "$HOME" \
            --exclude='.claude/projects/*-src-embargoed*' \
            .claude/projects \
            "${state_dir#"$HOME"/}" \
            -C "$workdir" claude-backup/manifest.tsv |
        zstd -q -T0 |
        gpg --symmetric --cipher-algo AES256 --no-symkey-cache \
            "${gpg_opts[@]}" -o "$out.part"
    mv "$out.part" "$out"
    echo "wrote $out ($(du -h "$out" | cut -f1))"
}

restore() {
    local file=${1:-} kind label dir rc=0 have
    [ -n "$file" ] || { echo "usage: $0 restore <file>" >&2; exit 2; }
    need_state_in_home
    # global, and on EXIT: with set -e a failure exits without
    # returning, and the trap runs after the function's locals are gone
    workdir=$(mktemp -d)
    trap 'rm -rf "$workdir"' EXIT
    gpg --decrypt --no-symkey-cache "${gpg_opts[@]}" "$file" |
        zstd -q -d | tar -C "$workdir" -xf -
    # keep a local file that is newer than the backup's
    (cd "$workdir" && find .claude "${state_dir#"$HOME"/}" -type f) |
        while read -r f; do
            if [ ! -e "$HOME/$f" ] || [ "$workdir/$f" -nt "$HOME/$f" ]; then
                mkdir -p "$(dirname "$HOME/$f")"
                cp -p "$workdir/$f" "$HOME/$f"
            fi
        done
    echo "restored $file"
    have=$(find "$workdir/${state_dir#"$HOME"/}" -name '*.tsv' -printf '%f\n' \
        2>/dev/null | sed 's/\.tsv$//' | sort | paste -sd ' ')
    echo "snapshots: ${have:-none}; this container: $container"
    while IFS=$'\t' read -r kind label dir; do
        [ -d "$dir" ] && continue
        echo "missing ($kind) $label: $dir"
        [ "$kind" = session ] && rc=3
    done < "$workdir/claude-backup/manifest.tsv"
    [ $rc = 0 ] || echo "clone or create the session directories before resume" >&2
    return $rc
}

# the folder name Claude Code files a directory's sessions under
project_key() {
    echo "${1//[^A-Za-z0-9]/-}"
}

# $1 escaped for a sed regex or replacement with | as the delimiter
# shellcheck disable=SC2001  # a bracket expression, not a fixed string
sed_re() { sed 's/[][\.*^$|]/\\&/g' <<<"$1"; }
# shellcheck disable=SC2001
sed_repl() { sed 's/[\&|]/\\&/g' <<<"$1"; }

# rewrite the "cwd" fields naming $2 or a path under it in transcript
# $1 to name $3 instead, keeping the file's time
rewrite_cwd() {
    local f=$1 tmp
    grep -qF "\"cwd\":\"$2" "$f" || return 0
    tmp=$f.move-tmp
    sed "s|\"cwd\":\"$(sed_re "$2")\([/\"]\)|\"cwd\":\"$(sed_repl "$3")\1|g" \
        "$f" > "$tmp"
    touch -r "$f" "$tmp"
    mv "$tmp" "$f"
}

move() {
    local dry=0 old new projects d dir cwd src dest key f rel conflicts
    local running plan rows tmp
    case "${1:-}" in -n|--dry-run) dry=1; shift ;; esac
    if [ $# != 2 ]; then
        echo "usage: $0 move [-n|--dry-run] <old dir> <new dir>" >&2
        exit 2
    fi
    old=${1%/} new=${2%/}
    [ -d "$new" ] ||
        { echo "$new does not exist; move or clone it first" >&2; exit 1; }
    new=$(readlink -f "$new")
    # the old path as sessions recorded it: symlinks resolved, if it
    # is still there
    [ ! -d "$old" ] || old=$(readlink -f "$old")
    case $old in /*) ;; *)
        echo "$old: give an absolute path" >&2; exit 2 ;;
    esac
    [ "$old" != "$new" ] || { echo "$old and $new are the same" >&2; exit 1; }
    case $old$new in *[\"\\]*)
        echo "paths with \" or \\ are not supported" >&2; exit 1 ;;
    esac
    projects=$HOME/.claude/projects
    key=$(project_key "$old")

    # source<TAB>destination project folder: the old directory's own,
    # and those of directories under it (by the directory their
    # transcripts started in, since keys alone are ambiguous)
    plan=$(for d in "$projects/$key" "$projects/$key"-*; do
        [ -d "$d" ] || continue
        if [ "$d" = "$projects/$key" ]; then
            dir=$old
        else
            cwd=$(project_cwd "$d") || continue
            case $cwd in "$old"/*) dir=$cwd ;; *) continue ;; esac
        fi
        printf '%s\t%s\n' "$d" "$projects/$(project_key "$new${dir#"$old"}")"
    done)
    if [ -z "$plan" ]; then
        echo "no sessions recorded for $old" >&2
        exit 1
    fi

    # no session of either side may be running: it would keep writing
    # under the old name, or into the folder being merged into
    running=$(for f in "$HOME"/.claude/sessions/*.json; do
        [ -e "$f" ] || continue
        [ "$(cat "/proc/$(jq -r .pid "$f")/comm" 2>/dev/null)" = claude ] ||
            continue
        cwd=$(jq -r .cwd "$f")
        d=$projects/$(project_key "$cwd")
        if cut -f1,2 <<<"$plan" | tr '\t' '\n' | grep -qxF "$d"; then
            jq -r '"  \(.name // "unnamed") (pid \(.pid)) in \(.cwd)"' "$f"
        fi
    done)
    if [ -n "$running" ] && [ $dry = 1 ]; then
        printf 'running, exit them first:\n%s\n' "$running" >&2
    elif [ -n "$running" ]; then
        printf 'running, nothing moved:\n%s\n' "$running" >&2
        echo "exit them first" >&2
        exit 1
    fi

    # a file in both folders, other than MEMORY.md, stops everything
    conflicts=$(while IFS=$'\t' read -r src dest; do
        [ -d "$dest" ] || continue
        (cd "$src" && find . -type f) | while read -r rel; do
            rel=${rel#./}
            [ "$rel" != memory/MEMORY.md ] || continue
            [ ! -e "$dest/$rel" ] || echo "  $dest/$rel"
        done
    done <<<"$plan")
    if [ -n "$conflicts" ]; then
        printf 'in both folders, nothing moved:\n%s\n' "$conflicts" >&2
        exit 1
    fi

    rows=$(for f in "$state_dir"/*.tsv; do
        [ -e "$f" ] || continue
        awk -F '\t' -v old="$old" -v c="$(basename "$f" .tsv)" \
            '$2 == old || index($2, old "/") == 1 {print "  " c ": " $1}' "$f"
    done)

    while IFS=$'\t' read -r src dest; do
        if [ -d "$dest" ]; then
            echo "merge $src into $dest"
        else
            echo "move $src to $dest"
        fi
    done <<<"$plan"
    [ -z "$rows" ] || printf 'update snapshot entries:\n%s\n' "$rows"
    if [ $dry = 1 ]; then
        return 0
    fi

    while IFS=$'\t' read -r src dest; do
        while read -r f; do
            rewrite_cwd "$f" "$old" "$new"
        done < <(find "$src" -name '*.jsonl')
        if [ ! -d "$dest" ]; then
            mv "$src" "$dest"
            continue
        fi
        (cd "$src" && find . -type f) | while read -r rel; do
            rel=${rel#./}
            if [ "$rel" = memory/MEMORY.md ] && [ -e "$dest/$rel" ]; then
                # append the index lines the destination lacks
                tmp=$(grep -vxF -f "$dest/$rel" "$src/$rel" || true)
                [ -z "$tmp" ] || printf '%s\n' "$tmp" >> "$dest/$rel"
                rm "$src/$rel"
            else
                mkdir -p "$(dirname "$dest/$rel")"
                mv "$src/$rel" "$dest/$rel"
            fi
        done
        find "$src" -depth -type d -empty -delete
        [ ! -d "$src" ] || echo "left behind in $src: $(ls -A "$src")" >&2
    done <<<"$plan"

    for f in "$state_dir"/*.tsv; do
        [ -e "$f" ] || continue
        tmp=$f.new
        awk -F '\t' -v OFS='\t' -v old="$old" -v new="$new" '
            $2 == old || index($2, old "/") == 1 {
                $2 = new substr($2, length(old) + 1)
            }
            {print}' "$f" > "$tmp"
        if cmp -s "$f" "$tmp"; then rm "$tmp"; else mv "$tmp" "$f"; fi
    done

    # what is left to do by hand
    while IFS=$'\t' read -r _ dest; do
        [ -d "$dest/memory" ] || continue
        grep -rlF "$old" "$dest/memory" | sed 's/^/mentions the old path: /'
    done <<<"$plan"
    if jq -e --arg d "$old" '.projects | has($d)' "$HOME/.claude.json" \
        >/dev/null 2>&1; then
        # shellcheck disable=SC2088  # printed, not expanded
        echo "~/.claude.json keeps the settings of $old (trust, allowed" \
            "tools); Claude Code asks for trust again in $new"
    fi
    echo "resume from $new with claude --resume <id>, or with resume"
}

rename() {
    local name sock bin wid
    located_sessions | while IFS=$'\t' read -r name _ _ _ sock bin _ _ wid; do
        [ -n "$wid" ] || continue
        tmux_at "$bin" "$sock" rename-window -t "$wid" "$name"
        echo "window $wid: $name"
    done
}

case "${1:-}" in
    save) save ;;
    resume) shift; resume "$@" ;;
    rename) rename ;;
    sync) save; rename ;;
    list) column -t -s $'\t' "$state" ;;
    backup) shift; backup "$@" ;;
    restore) shift; restore "$@" ;;
    move) shift; move "$@" ;;
    *) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
